# ImageFlasherWGPU Environment Configuration
# Copy this file to .env and adjust values for your deployment

# Application Configuration
NODE_ENV=production
WEB_PORT=8000
WEBSOCKET_PORT=5010

# Reddit Scraper Configuration
REDDIT_SUBREDDIT=worldnews
REDDIT_MAX_PAGES=3
REDDIT_PAGE_DELAY=2.0
REDDIT_IMAGE_DELAY=1.0

# Image Processing Configuration
VHS_LUMA_BANDWIDTH=5
VHS_CHROMA_BANDWIDTH=8
VHS_NOISE_LEVEL=10.0
IMAGE_RESIZE_WIDTH=512
IMAGE_RESIZE_HEIGHT=512

# Redis Configuration (if using external Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Performance Configuration
MAX_QUEUE_SIZE=1000
SEND_DELAY=0.5
MAX_CONCURRENT_DOWNLOADS=5

# Security Configuration
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring Configuration
ENABLE_METRICS=false
METRICS_PORT=9090

# Development Configuration
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Domain Configuration (for production HTTPS)
DOMAIN_NAME=localhost
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem