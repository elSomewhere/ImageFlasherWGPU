# ImageFlasherWGPU runtime configuration
# Export these values or load them in your process supervisor.

NODE_ENV=production
WEB_PORT=8000
WEBSOCKET_PORT=5010
CRAWLER_CONTROL_PORT=5011

# Bind the public artifact stream to 0.0.0.0 only for trusted LAN viewers.
CRAWLER_IMAGE_HOST=127.0.0.1
CRAWLER_CONTROL_HOST=127.0.0.1

# Autonomous journey defaults
CRAWLER_EXPLORATION=0.55
CRAWLER_CONTENT_POLICY=broad

# Compliance transport. Crawl-delay can raise the effective per-origin delay.
CRAWLER_PAGE_DELAY=1.0
CRAWLER_GLOBAL_CONCURRENCY=16
